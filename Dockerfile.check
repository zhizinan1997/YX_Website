FROM mcr.microsoft.com/playwright/python:v1.46.0-jammy

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    CHECK_MAIN_DATA_DIR=/app/main_data \
    CHECK_DATA_DIR=/app/check_data \
    CHECK_SCHEDULER_ENABLED=true

COPY requirements.check.txt /app/requirements.check.txt
RUN pip install --no-cache-dir -r /app/requirements.check.txt

COPY check_app /app/check_app

RUN mkdir -p /app/main_data /app/check_data

EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "1", "--threads", "4", "--access-logfile", "-", "--error-logfile", "-", "check_app.app:app"]
