            return Array.from(document.querySelectorAll(`#${cfg.specsTableBodyId} tr`)).map(tr => ({
                key: (tr.querySelector('.me-spec-key') || {}).value || '',
                value: (tr.querySelector('.me-spec-val') || {}).value || '',
            })).filter(r => r.key);
        }

