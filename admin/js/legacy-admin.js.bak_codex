                            <th style="padding:10px; text-align:left; width:48px; border-bottom:2px solid #ddd;">#</th>
                            <th style="padding:10px; text-align:left; border-bottom:2px solid #ddd;">鎸夐挳鍚嶇О</th>
                            <th style="padding:10px; text-align:left; border-bottom:2px solid #ddd;">璺宠浆閾炬帴</th>
                            <th style="padding:10px; text-align:left; border-bottom:2px solid #ddd;">缂╃暐鍥撅紙鍙€夛級</th>
                            <th style="padding:10px; text-align:center; width:90px; border-bottom:2px solid #ddd;">鎿嶄綔</th>
                        </tr>
                    </thead>
                    <tbody id="navIndustryCategoriesTbody">${rows}</tbody>
                </table>
            `;
            initNavIndustryCategoriesSortable();
            initNavIndustryCategoriesImagePreviews();
        }

        function onSolutionsPageUrlChange(select) {
            const idx = select.dataset.index;
            const nameInput = document.querySelector(`.nav-industry-name[data-index="${idx}"]`);
            if (!nameInput) return;

            const selectedOption = select.options[select.selectedIndex];
