                window_focus: '绐楀彛鑾峰緱鐒︾偣',
                window_blur: '绐楀彛澶卞幓鐒︾偣',
                scroll_to_bottom: '婊氬姩鍒板簳閮?,
                cta_click: '鐐瑰嚮 CTA',
                banner_click: '鐐瑰嚮妯箙',
                nav_click: '鐐瑰嚮瀵艰埅',
                sidebar_click: '鐐瑰嚮渚ц竟鏍?,
                footer_click: '鐐瑰嚮椤佃剼',
                image_view: '鏌ョ湅鍥剧墖',
                image_zoom: '鏀惧ぇ鍥剧墖',
                map_view: '鏌ョ湅鍦板浘',
                session_end: '浼氳瘽缁撴潫',
                product_view: '娴忚浜у搧',
                product_click: '鐐瑰嚮浜у搧',
                category_view: '娴忚鍒嗙被',
                blog_view: '娴忚鍗氬',
                news_view: '娴忚璧勮',
                video_view: '娴忚瑙嗛',
                faq_view: '鏌ョ湅 FAQ',
                help_view: '鏌ョ湅甯姪',
                login: '鐧诲綍',
