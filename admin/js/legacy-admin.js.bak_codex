            solutionsPagesList.forEach(page => {
                const selected = page.url === selectedUrl ? 'selected' : '';
                options.push(`<option value="${escapeHtml(page.url)}" ${selected}>${escapeHtml(page.name)}</option>`);
            });
            return options.join('');
        }

