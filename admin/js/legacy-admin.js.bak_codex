            del.type = 'button';
            del.textContent = '鉁?;
            del.className = 'me-row-del';
            del.style.cssText = 'position:static; margin-left:4px;';
            del.onclick = () => row.remove();
            row.appendChild(inp);
            row.appendChild(del);
            c.appendChild(row);
