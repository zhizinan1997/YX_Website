                    </div>
                    <div>
                        <span class="me-row-label">鏍囬</span>
                        <input type="text" class="form-control me-app-title" value="${escapeHtml(item.title || '')}" placeholder="搴旂敤鍦烘櫙鏍囬">
                    </div>
                    <div>
                        <span class="me-row-label">鎻忚堪</span>
                        <textarea class="form-control me-app-desc" rows="2" placeholder="搴旂敤鎻忚堪">${escapeHtml(item.desc || '')}</textarea>
                    </div>
                    <div>
                        <span class="me-row-label">鍦烘櫙鏍囩</span>
                        <input type="text" class="form-control me-app-scenario" value="${escapeHtml(item.scenario || '')}" placeholder="鍦烘櫙鏂囧瓧">
                    </div>
