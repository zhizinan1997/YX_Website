                    </div>
                    <div>
                        <span class="me-row-label">鎽樿</span>
                        <textarea class="form-control me-news-desc" rows="2" placeholder="鏂伴椈鎽樿">${escapeHtml(item.desc || '')}</textarea>
                    </div>
                </div>`;
            c.appendChild(row);
