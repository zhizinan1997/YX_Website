                if (data.success) {
                    if (msg) {
                        msg.style.color = '#28a745';
                        msg.textContent = '鉁?淇濆瓨鎴愬姛';
                        setTimeout(() => { msg.textContent = ''; }, 3000);
                    }
                } else if (msg) {
                    msg.style.color = '#dc3545';
                    msg.textContent = data.message || '淇濆瓨澶辫触';
                }
            } catch (e) {
