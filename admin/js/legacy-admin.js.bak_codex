                                ${item.image ? `<img src="${escapeHtml(item.image)}" style="width: 100%; height: 100%; object-fit: contain;" onerror="this.parentElement.innerHTML='<span style=\\'font-size:10px;color:#999;\\'>鍔犺浇澶辫触</span>'">` : '<span style="font-size: 10px; color: #999;">棰勮</span>'}
                            </div>
