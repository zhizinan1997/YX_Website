        function showSiteMetricHelp(metricKey) {
            const key = String(metricKey || '').trim();
            const item = SITE_REPORT_METRIC_HELP[key] || {
                title: '鎸囨爣璇存槑',
                meaning: '璇ユ寚鏍囩敤浜庤緟鍔╃悊瑙ｆ姤琛ㄣ€?,
                formula: '鎸夊綋鍓嶆姤琛ㄦ暟鎹簮杩涜鑱氬悎璁＄畻'
            };
            const sections = [
                `鍚箟锛?{item.meaning}`,
                `璁＄畻鏂规硶锛?{item.formula}`
            ];
            if (item.scope) sections.push(`缁熻鍙ｅ緞锛?{item.scope}`);
            if (item.example) sections.push(`绀轰緥锛?{item.example}`);
            if (item.note) sections.push(`娉ㄦ剰锛?{item.note}`);
            const text = sections.join('\n\n');
            showGlobalAlert(text, `${item.title} 路 璇存槑`);
        }

