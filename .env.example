SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars
PUBLIC_BASE_URL=https://www.hnmetachip.cn
TRUST_PROXY_HEADERS=true
# 可信代理网段（可选）：TRUST_PROXY_HEADERS 未显式设置时生效。
# 仅当直连地址（remote_addr）为回环/私网，或命中下列 IP/CIDR（逗号分隔）时
# 才信任 X-Forwarded-For / CF-Connecting-IP 等代理头；站点直接暴露公网时
# 保持留空可防止客户端伪造这些头绕过限流。
TRUSTED_PROXY_CIDRS=
SESSION_COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
HIDDEN_ADMIN_USERNAME=
HIDDEN_ADMIN_PASSWORD_HASH=
HIDDEN_ADMIN_PASSWORD=
# ESA 单域名部署不需要单独 CDN 域名；以下两项仅保留旧配置兼容。
CDN_ENABLED=false
CDN_DOMAIN=
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Turnstile 大陆代理回退（可选）：Cloudflare 校验不可达时经代理转发
TURNSTILE_PROXY_FALLBACK_ENABLED=false
TURNSTILE_PROXY_URL=
# Passkey 快速登录（可选；也可在后台「站点设置 → Passkey 快速登录」启用）
PASSKEY_ENABLED=false
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
PASSKEY_RP_NAME=
# 后台登录验证码提供商：cloudflare 或 aliyun_esa；未设置时兼容 Cloudflare。
ADMIN_CAPTCHA_PROVIDER=cloudflare
ADMIN_ESA_IDENTITY=
ADMIN_ESA_SCENE_ID=
ADMIN_ESA_REGION=cn
EMAIL_AUTH_ENABLED=false
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD_OR_APP_CODE=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
SMTP_NOTICE_EMAIL=
SMTP_PASSWORD_SET_AT=
SMTP_PASSWORD_EXPIRES_AT=
CHATBOT_API_KEY=
CHATBOT_API_BASE=https://api.openai.com/v1
CHATBOT_MODEL=gpt-4o-mini
PRODUCT_AI_API_KEY=
PRODUCT_AI_API_BASE=https://api.openai.com/v1
PRODUCT_AI_MODEL=gpt-4o-mini
