upstream website_upstream {
    server website:8000;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;
    root /app;

    client_max_body_size 100m;

    location = /__cdn_switch__ {
        internal;
        proxy_pass http://website_upstream/api/cdn/switch-header;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /cdn_assets/ {
        auth_request /__cdn_switch__;
        auth_request_set $cdn_enabled $upstream_http_x_cdn_enabled;
        auth_request_set $cdn_domain $upstream_http_x_cdn_domain;

        error_page 418 = @cdn_proxy;
        if ($cdn_enabled = "1") {
            return 418;
        }

        try_files $uri @website;
        expires 1h;
    }

    location @cdn_proxy {
        resolver 127.0.0.11 1.1.1.1 valid=30s ipv6=off;
        proxy_intercept_errors on;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
        proxy_pass $cdn_domain$request_uri;

        error_page 404 500 502 503 504 = @local_assets;
    }

    location @local_assets {
        try_files $uri @website;
    }

    location @website {
        proxy_pass http://website_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://website_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 81 default_server;
    server_name _;
    root /app;

    location /cdn_assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    location / {
        return 403;
    }
}
