upstream website_upstream {
    server yx-website:8000;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;
    root /app;

    access_log off;
    error_log /dev/null;

    client_max_body_size 100m;

    # /cdn_assets requests are forwarded to Flask, which decides:
    # - cdn_enabled=true  -> 302 redirect to configured CDN domain
    # - cdn_enabled=false -> serve local cdn_assets file
    location /cdn_assets/ {
        proxy_pass http://website_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location / {
        proxy_pass http://website_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}

server {
    listen 81 default_server;
    server_name _;
    root /app;

    access_log off;
    error_log /dev/null;

    location /cdn_assets/ {
        proxy_pass http://website_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-YX-CDN-Entry 1;
    }

    location / {
        return 403;
    }
}
